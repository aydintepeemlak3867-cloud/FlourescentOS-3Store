import sys
from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, 
    QPushButton, QLabel, QFrame, QSizePolicy
)
from PyQt6.QtCore import QUrl
from PyQt6.QtWebEngineWidgets import QWebEngineView

class EbaPortApp(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("FluorescentOS - EBA Port")
        self.resize(950, 650)
        
        # Tema ve Tasarım
        self.setStyleSheet("""
            QWidget {
                background-color: #161616;
                color: #e0e0e0;
                font-family: 'Segoe UI', Arial, sans-serif;
            }
            QFrame#TopBar {
                background-color: #1f1f1f;
                border-bottom: 1px solid #2a2a2a;
                border-radius: 6px;
            }
            QPushButton {
                background-color: #252525;
                color: #ffffff;
                border: 1px solid #444;
                border-radius: 4px;
                padding: 6px 12px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #007acc;
                border: 1px solid #007acc;
            }
        """)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(10, 10, 10, 10)
        layout.setSpacing(10)

        # Üst Bilgi ve Kontrol Çubuğu
        top_bar = QFrame()
        top_bar.setObjectName("TopBar")
        top_layout = QHBoxLayout(top_bar)
        top_layout.setContentsMargins(10, 6, 10, 6)
        
        self.title_label = QLabel("🎓 FlourescentOS için EBA resmi sürümü(TR)")
        self.title_label.setStyleSheet("color: #007acc; font-weight: bold; font-size: 13px;")
        top_layout.addWidget(self.title_label)

        top_layout.addStretch()

        self.home_btn = QPushButton("🏠 EBA Ana Menü")
        self.home_btn.clicked.connect(self.go_home)
        top_layout.addWidget(self.home_btn)

        self.refresh_btn = QPushButton("🔄 Yenile")
        self.refresh_btn.clicked.connect(self.reload_page)
        top_layout.addWidget(self.refresh_btn)

        layout.addWidget(top_bar)

        # Web Görünüm Alanı (Render kaymasını önlemek için Policy eklendi)
        self.browser = QWebEngineView()
        self.browser.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
        layout.addWidget(self.browser)

        # Doğrudan EBA'ya kilitle
        self.go_home()

    def go_home(self):
        self.browser.setUrl(QUrl("https://www.eba.gov.tr"))

    def reload_page(self):
        self.browser.reload()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = EbaPortApp()
    window.show()
    sys.exit(app.exec())